# Finales de línea: LF en todo el repo, también en Windows.
* text=auto eol=lf

# Scripts propios de Windows
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.woff2 binary
*.glb binary
*.ktx2 binary
*.mp4 binary
*.webm binary

# Blender (Git LFS, ADR-005)
*.blend filter=lfs diff=lfs merge=lfs -text

# Bitácora: cada rama solo agrega al final; al fusionar se juntan las dos versiones en vez de chocar.
equipo/BITACORA.md merge=union
