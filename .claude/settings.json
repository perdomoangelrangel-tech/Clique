{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(git rebase *)",
      "Bash(git switch *)",
      "Bash(git push -u origin ot/*)",
      "Bash(git push origin ot/*)",
      "Bash(git push --force-with-lease origin ot/*)",
      "Bash(gh pr *)",
      "Bash(pnpm install *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm --filter *)",
      "Bash(python -m unittest *)",
      "Bash(sha256sum -c *)",
      "Bash(node --version)",
      "Bash(pnpm --version)"
