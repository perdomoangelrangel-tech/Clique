# Copia este archivo como .env y llena los valores. .env nunca se sube a git.
# Lo que usa la app hoy está abajo, en "Configuración de la app" (viene de la app original; los comentarios
# en inglés se traducen cuando se toque cada parte).

# ── Supabase: proyecto "Clique" (ref rrmifvptjajfvxxdqqek, us-east-1) ──
SUPABASE_URL=https://rrmifvptjajfvxxdqqek.supabase.co
SUPABASE_PUBLISHABLE_KEY=        # clave publicable (pública por diseño): panel de Supabase → Project Settings → API Keys
# SUPABASE_SERVICE_ROLE_KEY y la contraseña de la base nunca van al navegador ni a git.

# ── Venta de fichas (D3): apagada hasta el dictamen legal ──
PURCHASES_ENABLED=false

# ── Configuración de la app ──
# Settings for a hosted copy. On Railway/Render/Fly you type these into the host's "Variables" page.
# Never commit a real .env file (it is in .gitignore).

# REQUIRED. Your funds password (the "Add funds" box). 10+ characters, your own, not the one in the code.
ADMIN_PASSWORD=

# Optional. The time zone weeks are measured in (Monday 00:00 to Monday 00:00). Default America/Mexico_City.
# Any name like Europe/Madrid or UTC works. (The older WEEK_TZ_OFFSET_HOURS=-6, a fixed offset, still works if you set it.)
WEEK_TIMEZONE=America/Mexico_City

# Optional. Cash every new account starts with (default 1000).
START_BALANCE=1000

# Optional. What the weekly account is set to when a week starts (default 1000, 0 = off). WEEKLY_BONUS is the older name.
WEEKLY_ALLOCATION=1000
# Everybody gets this in the weekly account every Wednesday at 12:00 (WEEK_TIMEZONE). 0 turns it off.
# MIDWEEK_BONUS=500
# Funds added with the "Add funds" box wait for a vote of everybody else; it ends at the latest after this many hours.
# FUNDS_VOTE_HOURS=24

# Optional. The weekly minimum: poll bets and casino rounds needed in a week to stay in the challenge. Whoever misses it loses
# the week automatically (the punishment, no reward). Defaults 1 and 25; set both to 0 to turn the rule off.
# WEEKLY_MIN_POLL_BETS=1
# WEEKLY_MIN_CASINO_BETS=25

# Optional. Weekly rewards by final position (1st first) and what other active players get. Paid into the accumulated account.
# WEEKLY_REWARDS=400,250,150,100,50
# PARTICIPATION_REWARD=25

# Optional. Only if voice calls do not connect for some people: a TURN relay (see DEPLOY.md, "Voice rooms").
# TURN_URL=turn:turn.example.com:3478
# TURN_SECRET=
# ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]

# Every other economic setting is listed in ECONOMY.md.

# Needed for "Forgot your password?" by email: ONE email service (see DEPLOY.md, "Email: forgotten passwords") and who it is from.
# EMAIL_FROM="Clique <noreply@yourdomain.com>"
# RESEND_API_KEY=
# BREVO_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# Optional. New accounts must give an email (default). 0 makes it optional.
# EMAIL_REQUIRED=1

# Optional. Rank the weekly loser by "netWorth" (default) or "cash".
RANK_BY=netWorth

# Optional. Type any new label here and redeploy to start a new season: accounts and circles stay,
# everyone gets START_BALANCE again, markets and history are cleared. The same label never runs twice.
SEASON_RESET=

# Already set inside the Dockerfile, do not change:
#   CLIQUE_ENV=production   DATA_DIR=/data   HOST=0.0.0.0
# Provided by the host automatically: PORT

# Optional. Loans, ranks, weekly challenges, milestones and friend transfers (every one is explained in ECONOMY.md, sections 7 to 11).
# LOANS_ENABLED=1
# LOAN_MAX_PCT_OF_ALLOCATION=50
# LOAN_FEE=0                     # a fixed fee per loan; 0 = interest-free
# LOAN_ALLOC_REPAY_PCT=50        # share of the next weekly allocation that goes to an unpaid loan first
# GOALS_ENABLED=1
# REWARD_SCALE=1                 # multiplies every challenge and milestone reward
# TRANSFERS_ENABLED=1
# TRANSFER_ACCOUNTS=weekly,accumulated   # which accounts can be sent from; money always lands in the same kind of account
# TRANSFER_DAILY_LIMIT=250               # per person per day, from the accumulated account
# TRANSFER_WEEKLY_DAILY_LIMIT=500        # per person per day, from the weekly account
# TRANSFER_WEEKLY_RECEIVER_PCT=100       # a weekly transfer can top a friend up to this share of the weekly allocation (0 = no cap)
