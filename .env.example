# Copia este archivo como .env.local y llena los valores. .env.local nunca se sube a git.

# Supabase: proyecto "Clique" (ref rrmifvptjajfvxxdqqek, us-east-1)
VITE_SUPABASE_URL=https://rrmifvptjajfvxxdqqek.supabase.co
